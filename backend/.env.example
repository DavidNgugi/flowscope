# ---- LLM providers -------------------------------------------------------
# Purpose-based selection. LLM_PROVIDER/LLM_MODEL are the default; each purpose
# can be routed to a different provider and model, so a cheap text model can do
# synthesis while a vision model does the frames.
#
# Known providers: anthropic, openai, deepseek, openai_compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Examples:
#   Frames on OpenAI, text on DeepSeek:
#     LLM_PROVIDER=openai
#     LLM_MODEL=gpt-5-mini
#     LLM_SYNTHESIS_PROVIDER=deepseek
#     LLM_SYNTHESIS_MODEL=deepseek-flash
#   Everything on DeepSeek (deepseek-flash is vision-capable; v4-pro is not):
#     LLM_PROVIDER=deepseek
#     LLM_MODEL=deepseek-flash
#   A local or self-hosted OpenAI-compatible server:
#     LLM_PROVIDER=openai_compatible
#     LLM_MODEL=<model-name>
#     OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1

# LLM_VISION_PROVIDER=
# LLM_VISION_MODEL=
# LLM_SYNTHESIS_PROVIDER=
# LLM_SYNTHESIS_MODEL=
# LLM_COMPARISON_PROVIDER=
# LLM_COMPARISON_MODEL=

# Image detail sent with frame analyses: low | high | auto.
LLM_IMAGE_DETAIL=high
LLM_TIMEOUT_SECONDS=180
# low | medium | high (reasoning models only; empty omits the parameter)
LLM_REASONING_EFFORT=low

# ---- provider credentials ------------------------------------------------
# Set only the providers you intend to use. A provider without a key is simply
# unavailable; selecting it produces a clear configuration error.
ANTHROPIC_API_KEY=
# Kept for backwards compatibility; LLM_MODEL is the preferred setting.
ANTHROPIC_MODEL=claude-sonnet-5
# Any OpenAI-compatible vendor works: OpenAI, DeepSeek, xAI, Mistral, Groq,
# Together, OpenRouter, or a local vLLM/Ollama server.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

WHISPER_MODEL_SIZE=small

DATA_DIR=./data
VIDEO_MAX_HEIGHT=720

# YouTube authentication (set at most one). A Netscape-format cookie file is
# recommended for Docker; browser extraction is convenient for local runs.
# YTDLP_COOKIE_FILE=/app/secrets/youtube-cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# concurrency
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_LLM_CALLS=6
CPU_WORKER_THREADS=4
IO_WORKER_THREADS=4

# frame extraction tuning
SCENE_DETECT_THRESHOLD=0.30
FRAME_DEDUPE_HAMMING_THRESHOLD=10
MIN_FRAMES_FLOOR=8
